# 参考素材（原 APK、参考图、网页存档）不进仓库
references/

save/

# 依赖与构建产物（本仓库无构建步骤，这些只在本地/CI 出现）
node_modules/
package-lock.json
_site/
dist/
__pycache__/

# Tauri 桌面版：web/ 由 tools/build-tauri-web.cjs 生成，
# icons/ 由 `npx tauri icon app-icon.png` 生成，target/ 是 Rust 编译产物
src-tauri/web/
src-tauri/icons/
src-tauri/target/
src-tauri/dist/
src-tauri/node_modules/

# 安卓：gen/android 是 `tauri android init` 生成的 Android 工程（可再生，不进仓库），
# gen/schemas 是构建时生成的权限 schema。
# ⚠️ 但那个工程里有两处**必要补丁**（node 路径硬编码、rust 任务改跳过），
#    重新 init 之后要照 docs/安卓版构建与实测.md 的「生成工程里的两处补丁」再打一次。
src-tauri/gen/android/
src-tauri/gen/schemas/

# macOS / Windows 的目录噪音
.DS_Store
Thumbs.db
desktop.ini

# 检查工具留下的临时截图
tools/research/tmp-*.png
# 开发截图是「跑出来」的产物（headless-shot / test-battle 生成），要留证据时手动 git add -f
tools/verification/*.png
tools/research/*.png
tools/research/*.jpg
tools/research/battle-check/

# 双机同步：名字 / 对端地址 / 口令每台机器都不一样，不进仓库（首次运行会自动生成）
scripts/sync/sync.config.json

# AI 超分（tools/ai-upscale.py）：out/ 是跑出来的中间产物与对比图，属本地产物。
# 1x 原始按钮留档在 references/ 下（references/ 整目录上面已忽略）——只作参考，
# 不进游戏也不进仓库；.bak-upscale/ 是原地放大前的 1x 备份（buttons / icons 都有）。
out/
images/classic/**/.bak-upscale/


